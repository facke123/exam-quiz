# ============================
# 应用配置
# ============================
APP_PORT=3000
APP_PREFIX=/api
NODE_ENV=development

# ============================
# 数据库配置 MySQL 8.0
# ============================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=ruankao
DB_SYNC=false
DB_LOGGING=false

# ============================
# Redis 配置
# ============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=ruankao:

# ============================
# JWT 配置
# ============================
JWT_SECRET=your-jwt-secret-key-change-this
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================
# MinIO 配置
# ============================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ruankao
MINIO_USE_SSL=false

# ============================
# RabbitMQ 配置
# ============================
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=ai_task

# ============================
# AI 配置
# ============================
AI_API_KEY=
AI_API_URL=
AI_MODEL=gpt-4
AI_MAX_TOKENS=4096

# ============================
# 支付配置
# ============================
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_KEY=
WECHAT_NOTIFY_URL=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=

# ============================
# 跨域配置
# ============================
CORS_ORIGIN=*
